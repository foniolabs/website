# ===== Existing =====
# Resend API Key (used by /api/contact route)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_123456789

# ===== Sanity (added during sanity-migration) =====
# From sanity.io project dashboard
NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxxxxx
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-05-31

# Sanity write token (editor role). Used by:
#  - migration scripts (Day 7)
#  - revalidation webhook signature verification
#  - Claude Code MCP server (Day 10)
# Generate at: https://www.sanity.io/manage/project/<projectId>/api#tokens
SANITY_API_WRITE_TOKEN=sk_...

# Read token for draft mode preview
SANITY_API_READ_TOKEN=sk_...

# Secret used to authenticate the Sanity → Next.js revalidation webhook
# Random string, must match what's configured in Sanity webhook settings
SANITY_REVALIDATE_SECRET=change-me-to-a-long-random-string

# ===== HubSpot (Day 8) =====
# Free dev account at https://developers.hubspot.com
# Found in HubSpot account settings → integrations
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=00000000
# Form ID for the contact form (different forms can be referenced per page via Sanity siteSettings)
NEXT_PUBLIC_HUBSPOT_CONTACT_FORM_ID=00000000-0000-0000-0000-000000000000

# ===== Google Analytics 4 (Day 8) =====
# Measurement ID (G-XXXXXXXXXX) from https://analytics.google.com
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ===== Site URL =====
# Used for absolute URLs in OG images, sitemap, JSON-LD
NEXT_PUBLIC_SITE_URL=https://foniolabs.xyz
